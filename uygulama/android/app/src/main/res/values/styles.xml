<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Oyun (açılıştan sonraki tema, postSplashScreenTheme): başlık çubuğu yok; pencere zemini oyunun arena mavisi.
         Capacitor SystemBars bu rengi okuyup durum ve gezinme çubuklarının arkasına da boyar (getThemeColor): bu yüzden
         düz renk olmalı; çizim (gradient drawable) verilirse renk yerine anlamsız bir değer okunur -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/hbArkaPlan</item>
    </style>

    <!-- Açılış (v1.3.1 canlı açılış): logo yok; uygulamaya basıldığı andan itibaren derin lacivert (hbAcilis #0B1120).
         Android 12+ sistem açılış ekranı yalnızca düz renk alır: oyunun açılış sahnesinin başlangıç rengi. WebView zemini ve
         sahne de aynı renkle başlar; sahne, yazıdan hemen önce lacivert-mavi geçişe (#0B1120 -> #1E3A8A) yumuşakça aydınlanır.
         Simge saydam (sistem uygulama simgesini göstermez); durum ve gezinme çubuğu simgeleri koyu zeminde açık renk -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/hbAcilis</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="windowSplashScreenBackground">@color/hbAcilis</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/hb_bos_simge</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
