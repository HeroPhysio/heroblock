{
  "name": "heroblock-uygulama",
  "version": "1.0.0",
  "private": true,
  "description": "Hero Block: Google Play ve App Store uygulaması (Capacitor)",
  "scripts": {
    "sync": "cap sync",
    "android:sync": "cap sync android",
    "android:ac": "cap open android",
    "admob": "node scripts/admob-ayarla.mjs",
